// Finalized accent — indigo. Matches the TWEAK_DEFAULTS the designer shipped
// in the prototype (applied once on mount there). Overrides tokens.styl defaults
// so tokens.styl stays a verbatim copy of the source design system.
:root
  --accent-h: 265
  --accent-c: 0.19

// View Transitions custom animations
@keyframes vt-fade-in
  from
    opacity: 0
  to
    opacity: 1

@keyframes vt-fade-out
  from
    opacity: 1
  to
    opacity: 0

::view-transition-old(root),
::view-transition-new(root)
  animation-duration: calc(500ms * var(--motion, 1))
  animation-timing-function: var(--spring-emphasized, cubic-bezier(0.05, 0.7, 0.1, 1))

::view-transition-old(root)
  animation-name: vt-fade-out

::view-transition-new(root)
  animation-name: vt-fade-in

// Morphing project cards
[style*="view-transition-name: project-"]::view-transition-group,
::view-transition-group(*)
  animation-duration: calc(560ms * var(--motion, 1))
  animation-timing-function: var(--spring-emphasized, cubic-bezier(0.05, 0.7, 0.1, 1))

@keyframes pulse
  0%
    transform: scale(1)
    opacity: 0.5
  70%
    transform: scale(2.4)
    opacity: 0
  100%
    transform: scale(2.4)
    opacity: 0

// Shy Owl Studios (/shy-owl) ----------------------------------------

// Scoped accent: pages/shy-owl.vue sets data-accent="shy-owl" on <html>
// via useHead htmlAttrs (SSG-rendered, so no colour flash). Every derived
// M3 token is declared on the root element and substitutes var(--accent-h/-c)
// there, so light AND dark palettes re-derive from these two lines.
:root[data-accent="shy-owl"]
  --accent-h: 333
  --accent-c: 0.17

// Shy Owl filled button — black (inverts on dark theme), cross-fading to
// the brand gradient on hover. ::before carries the gradient; isolation
// keeps it above the background but under the label.
.btn-gradient
  position: relative
  isolation: isolate
  overflow: hidden
  background: var(--on-surface)
  color: var(--surface)

.btn-gradient::before
  content: ''
  position: absolute
  inset: 0
  z-index: -1
  background: var(--brand-gradient-135)
  opacity: 0
  transition: opacity var(--dur-short) var(--spring-gentle)

.btn-gradient:hover
  color: #fff
  box-shadow: 0 6px 26px -6px unquote("color-mix(in oklch, #E94057 55%, transparent)")

.btn-gradient:hover::before
  opacity: 1

// Skip link for the studio layout
.skip-link
  position: absolute
  left: 16px
  top: -48px
  z-index: 100
  padding: 10px 18px
  border-radius: var(--shape-full)
  background: var(--on-surface)
  color: var(--surface)
  font-weight: 600
  transition: top var(--dur-short) var(--spring-gentle)

.skip-link:focus-visible
  top: 12px
